APP_HOST=127.0.0.1
APP_PORT=8000

# Leave blank to use default paths relative to the backend directory
DATA_DIR=
VECTOR_DB_DIR=

# Set to true to enable LLM synthesis
ENABLE_LLM=false

# LLM backend: "llama_cpp" (default) or "ollama"
LLM_BACKEND=llama_cpp

# --- llama.cpp settings (used when LLM_BACKEND=llama_cpp) ---
MODEL_PATH=
LLAMA_SERVER_BIN=llama-server
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8080
LLAMA_CONTEXT_SIZE=2048
LLAMA_GPU_LAYERS=0
LLAMA_THREADS=4
LLAMA_PARALLEL=1
LLAMA_USE_MLOCK=false

# --- Ollama settings (used when LLM_BACKEND=ollama) ---
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3
